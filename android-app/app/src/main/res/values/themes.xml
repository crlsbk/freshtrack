<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FreshTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorSurfaceContainerLow">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.FreshTrack.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.FreshTrack.Large</item>
        <item name="materialCardViewStyle">@style/Widget.FreshTrack.Card</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.FreshTrack.Splash" parent="Theme.FreshTrack">
        <item name="android:windowBackground">@color/header_bg</item>
    </style>

    <style name="Theme.FreshTrack.Scanner" parent="Theme.FreshTrack">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Shape.FreshTrack.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape.FreshTrack.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.FreshTrack.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.FreshTrack.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Text.FreshTrack.Kpi" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Text.FreshTrack.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Text.FreshTrack.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
