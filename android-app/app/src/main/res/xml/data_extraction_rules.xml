<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión (JWT cifrado con una llave del Keystore) no se respalda en la nube ni se transfiere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="freshtrack_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="freshtrack_session.xml" />
    </device-transfer>
</data-extraction-rules>
