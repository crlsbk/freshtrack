<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-auth POST /api/v1/auth/devices (registro seguro del dispositivo móvil) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="uuid"><xs:restriction base="xs:string"><xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/></xs:restriction></xs:simpleType>
  <xs:element name="device_register_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id_dispositivo" type="uuid"/>
        <xs:element name="modelo" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="120"/></xs:restriction></xs:simpleType></xs:element>
        <xs:element name="version_so" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="40"/></xs:restriction></xs:simpleType></xs:element>
        <xs:element name="version_app" minOccurs="0"><xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="40"/></xs:restriction></xs:simpleType></xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
