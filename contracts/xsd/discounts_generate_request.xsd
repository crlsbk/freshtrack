<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning POST /api/v1/planning/discounts/generate (la app de escritorio lo valida antes de enviar) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="discounts_generate_request">
    <xs:complexType>
      <xs:all>
        <xs:element name="dias_hasta">
          <xs:simpleType><xs:restriction base="xs:integer"><xs:minInclusive value="0"/><xs:maxInclusive value="60"/></xs:restriction></xs:simpleType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
