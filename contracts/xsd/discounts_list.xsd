<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning GET /api/v1/planning/discounts (respuesta) -->
<!--
  Contrato abierto: la raíz acepta cualquier hijo (xs:any processContents="lax") para que la app
  no se rompa si el backend agrega campos. Los elementos globales de abajo fijan el tipo de los
  campos clave donde sea que aparezcan (raíz, <item>, <detalle>, ...). Un elemento vacío
  (<campo /> = None en el servidor) siempre es válido.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="discounts_list">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="total" type="conteo_o_vacio"/>
  <xs:element name="sugeridos" type="conteo_o_vacio"/>
  <xs:element name="aprobados" type="conteo_o_vacio"/>
  <xs:element name="rechazados" type="conteo_o_vacio"/>
  <xs:element name="id_sku" type="id_o_vacio"/>
  <xs:element name="id_locacion" type="id_o_vacio"/>
  <xs:element name="ingreso_potencial" type="numero_o_vacio"/>
  <xs:element name="unidades" type="numero_o_vacio"/>
  <xs:element name="descuento_pct" type="numero_o_vacio"/>
  <xs:element name="precio_normal" type="numero_o_vacio"/>
  <xs:element name="precio_nuevo" type="numero_o_vacio"/>
  <xs:element name="cantidad" type="numero_o_vacio"/>
  <xs:element name="precio_costo" type="numero_o_vacio"/>
  <xs:element name="dias_restantes" type="entero_o_vacio"/>
  <xs:element name="estado" type="estado_descuento"/>

  <xs:simpleType name="conteo_o_vacio">
    <xs:union memberTypes="xs:nonNegativeInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="id_o_vacio">
    <xs:union memberTypes="xs:positiveInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <!-- Número (entero, decimal o notación científica que emite str(float) de Python) o vacío (None). -->
  <xs:simpleType name="numero_o_vacio">
    <xs:union memberTypes="xs:decimal xs:double">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value=""/>
          <xs:enumeration value="nan"/>
          <xs:enumeration value="inf"/>
          <xs:enumeration value="-inf"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="entero_o_vacio">
    <xs:union memberTypes="xs:integer">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="estado_descuento">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="SUGERIDO"/>
      <xs:enumeration value="APROBADO"/>
      <xs:enumeration value="RECHAZADO"/>
      <xs:enumeration value="APLICADO"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
