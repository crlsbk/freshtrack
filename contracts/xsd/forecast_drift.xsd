<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning GET /api/v1/planning/forecast/drift (respuesta) -->
<!--
  Contrato abierto: la raíz acepta cualquier hijo (xs:any processContents="lax") para que la app
  no se rompa si el backend agrega campos. Los elementos globales de abajo fijan el tipo de los
  campos clave donde sea que aparezcan (raíz, <item>, <detalle>, ...). Un elemento vacío
  (<campo /> = None en el servidor) siempre es válido.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="forecast_drift">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="id_sku" type="id_o_vacio"/>
  <xs:element name="id_locacion" type="id_o_vacio"/>
  <xs:element name="total_tiendas" type="conteo_o_vacio"/>
  <xs:element name="confiables" type="conteo_o_vacio"/>
  <xs:element name="vigilancia" type="conteo_o_vacio"/>
  <xs:element name="no_confiables" type="conteo_o_vacio"/>
  <xs:element name="sin_datos" type="conteo_o_vacio"/>
  <xs:element name="total_anomalias_sku" type="conteo_o_vacio"/>
  <xs:element name="n_series" type="conteo_o_vacio"/>
  <xs:element name="productos_con_anomalia" type="conteo_o_vacio"/>
  <xs:element name="horizonte_dias" type="conteo_o_vacio"/>
  <xs:element name="mae" type="numero_o_vacio"/>
  <xs:element name="rmse" type="numero_o_vacio"/>
  <xs:element name="wmape" type="numero_o_vacio"/>
  <xs:element name="sesgo" type="numero_o_vacio"/>
  <xs:element name="naive_mae" type="numero_o_vacio"/>
  <xs:element name="naive_wmape" type="numero_o_vacio"/>
  <xs:element name="mejora_vs_naive_pct" type="numero_o_vacio"/>
  <xs:element name="edad_horas" type="numero_o_vacio"/>
  <xs:element name="psi" type="numero_o_vacio"/>
  <xs:element name="z_nivel" type="numero_o_vacio"/>
  <xs:element name="cambio_nivel_pct" type="numero_o_vacio"/>
  <xs:element name="ratio_volatilidad" type="numero_o_vacio"/>
  <xs:element name="delta_ceros_pp" type="numero_o_vacio"/>
  <xs:element name="dias_atipicos" type="numero_o_vacio"/>
  <xs:element name="media_base" type="numero_o_vacio"/>
  <xs:element name="media_reciente" type="numero_o_vacio"/>
  <xs:element name="requiere_reemplazo" type="booleano_o_vacio"/>
  <xs:element name="estado" type="estado_modelo"/>

  <xs:simpleType name="id_o_vacio">
    <xs:union memberTypes="xs:positiveInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="conteo_o_vacio">
    <xs:union memberTypes="xs:nonNegativeInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <!-- Número (entero, decimal o notación científica que emite str(float) de Python) o vacío (None). -->
  <xs:simpleType name="numero_o_vacio">
    <xs:union memberTypes="xs:decimal xs:double">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value=""/>
          <xs:enumeration value="nan"/>
          <xs:enumeration value="inf"/>
          <xs:enumeration value="-inf"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="booleano_o_vacio">
    <xs:union memberTypes="xs:boolean">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="estado_modelo">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="CONFIABLE"/>
      <xs:enumeration value="VIGILANCIA"/>
      <xs:enumeration value="NO_CONFIABLE"/>
      <xs:enumeration value="SIN_DATOS"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
