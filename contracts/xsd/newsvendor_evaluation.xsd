<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning POST /api/v1/planning/newsvendor/evaluate (respuesta) -->
<!--
  Contrato abierto: la raíz acepta cualquier hijo (xs:any processContents="lax") para que la app
  no se rompa si el backend agrega campos. Los elementos globales de abajo fijan el tipo de los
  campos clave donde sea que aparezcan (raíz, <item>, <detalle>, ...). Un elemento vacío
  (<campo /> = None en el servidor) siempre es válido.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="newsvendor_evaluation">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="id_sku" type="id_o_vacio"/>
  <xs:element name="id_locacion" type="id_o_vacio"/>
  <xs:element name="horizonte" type="conteo_o_vacio"/>
  <xs:element name="demanda_horizonte" type="numero_o_vacio"/>
  <xs:element name="inventario_util" type="numero_o_vacio"/>
  <xs:element name="inventario_riesgo" type="numero_o_vacio"/>
  <xs:element name="cantidad_sugerida" type="numero_o_vacio"/>
  <xs:element name="costo_faltante" type="numero_o_vacio"/>
  <xs:element name="costo_excedente" type="numero_o_vacio"/>
  <xs:element name="valor_salvamento" type="numero_o_vacio"/>
  <xs:element name="z_score" type="numero_o_vacio"/>
  <xs:element name="sigma_horizonte" type="numero_o_vacio"/>
  <xs:element name="stock_objetivo_newsvendor" type="numero_o_vacio"/>
  <xs:element name="stock_objetivo_simple" type="numero_o_vacio"/>
  <xs:element name="cantidad_newsvendor" type="numero_o_vacio"/>
  <xs:element name="cantidad_politica_simple" type="numero_o_vacio"/>
  <xs:element name="costo_esperado_newsvendor" type="numero_o_vacio"/>
  <xs:element name="costo_esperado_simple" type="numero_o_vacio"/>
  <xs:element name="ahorro_esperado" type="numero_o_vacio"/>
  <xs:element name="fractil_critico" type="fraccion_o_vacio"/>
  <xs:element name="acotado_por_caducidad" type="booleano_o_vacio"/>

  <xs:simpleType name="id_o_vacio">
    <xs:union memberTypes="xs:positiveInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="conteo_o_vacio">
    <xs:union memberTypes="xs:nonNegativeInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <!-- Número (entero, decimal o notación científica que emite str(float) de Python) o vacío (None). -->
  <xs:simpleType name="numero_o_vacio">
    <xs:union memberTypes="xs:decimal xs:double">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value=""/>
          <xs:enumeration value="nan"/>
          <xs:enumeration value="inf"/>
          <xs:enumeration value="-inf"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="fraccion_o_vacio">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:decimal">
          <xs:minInclusive value="0"/>
          <xs:maxInclusive value="1"/>
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="booleano_o_vacio">
    <xs:union memberTypes="xs:boolean">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
</xs:schema>
