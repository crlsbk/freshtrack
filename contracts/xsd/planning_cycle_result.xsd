<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning POST /api/v1/planning/cycle/run (respuesta) -->
<!--
  Contrato abierto: la raíz acepta cualquier hijo (xs:any processContents="lax") para que la app
  no se rompa si el backend agrega campos. Los elementos globales de abajo fijan el tipo de los
  campos clave donde sea que aparezcan (raíz, <item>, <detalle>, ...). Un elemento vacío
  (<campo /> = None en el servidor) siempre es válido.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="planning_cycle_result">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="id_locacion" type="id_o_vacio"/>
  <xs:element name="horizonte" type="conteo_o_vacio"/>
  <xs:element name="series" type="conteo_o_vacio"/>
  <xs:element name="total_recalibradas" type="conteo_o_vacio"/>
  <xs:element name="total_reutilizadas" type="conteo_o_vacio"/>
  <xs:element name="traslados_creados" type="conteo_o_vacio"/>
  <xs:element name="descuentos_creados" type="conteo_o_vacio"/>
  <xs:element name="lotes_vencidos_bloqueados" type="conteo_o_vacio"/>
  <xs:element name="actualizadas" type="conteo_o_vacio"/>
  <xs:element name="total" type="conteo_o_vacio"/>
  <xs:element name="revisadas" type="conteo_o_vacio"/>
  <xs:element name="total_evaluados" type="conteo_o_vacio"/>
  <xs:element name="TRASLADO" type="conteo_o_vacio"/>
  <xs:element name="DESCUENTO" type="conteo_o_vacio"/>
  <xs:element name="MERMA" type="conteo_o_vacio"/>
  <xs:element name="NORMAL" type="conteo_o_vacio"/>
  <xs:element name="total_tiendas" type="conteo_o_vacio"/>
  <xs:element name="confiables" type="conteo_o_vacio"/>
  <xs:element name="vigilancia" type="conteo_o_vacio"/>
  <xs:element name="no_confiables" type="conteo_o_vacio"/>
  <xs:element name="sin_datos" type="conteo_o_vacio"/>
  <xs:element name="total_anomalias_sku" type="conteo_o_vacio"/>
  <xs:element name="wmape" type="numero_o_vacio"/>
  <xs:element name="edad_horas" type="numero_o_vacio"/>
  <xs:element name="valor_rescatable_estimado" type="numero_o_vacio"/>
  <xs:element name="cantidad_sugerida" type="numero_o_vacio"/>
  <xs:element name="necesidad_neta" type="numero_o_vacio"/>
  <xs:element name="prioridad" type="prioridad"/>

  <xs:simpleType name="id_o_vacio">
    <xs:union memberTypes="xs:positiveInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="conteo_o_vacio">
    <xs:union memberTypes="xs:nonNegativeInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <!-- Número (entero, decimal o notación científica que emite str(float) de Python) o vacío (None). -->
  <xs:simpleType name="numero_o_vacio">
    <xs:union memberTypes="xs:decimal xs:double">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value=""/>
          <xs:enumeration value="nan"/>
          <xs:enumeration value="inf"/>
          <xs:enumeration value="-inf"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="prioridad">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="ALTA"/>
      <xs:enumeration value="MEDIA"/>
      <xs:enumeration value="BAJA"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
