<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning POST /api/v1/planning/purchase-orders (la app de escritorio lo valida antes de enviar) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="purchase_order_request">
    <xs:complexType>
      <xs:all>
        <xs:element name="id_proveedor" type="xs:positiveInteger"/>
        <xs:element name="lineas">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="linea" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="id_sku" type="xs:positiveInteger"/>
                    <xs:element name="id_locacion_destino" type="xs:positiveInteger"/>
                    <xs:element name="cantidad_lotes" type="xs:positiveInteger"/>
                  </xs:all>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="observaciones" minOccurs="0">
          <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="500"/></xs:restriction></xs:simpleType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
