<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning GET /api/v1/planning/purchase-orders (respuesta) -->
<!--
  Contrato abierto: la raíz acepta cualquier hijo (xs:any processContents="lax") para que la app
  no se rompa si el backend agrega campos. Los elementos globales de abajo fijan el tipo de los
  campos clave donde sea que aparezcan (raíz, <item>, <detalle>, ...). Un elemento vacío
  (<campo /> = None en el servidor) siempre es válido.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="purchase_orders_list">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="id_proveedor" type="id_o_vacio"/>
  <xs:element name="total_lotes" type="conteo_o_vacio"/>
  <xs:element name="n_tiendas" type="conteo_o_vacio"/>
  <xs:element name="tamano_bytes" type="conteo_o_vacio"/>
  <xs:element name="total_unidades" type="numero_o_vacio"/>
  <xs:element name="estado" type="estado_oc"/>
  <xs:element name="estado_envio_correo" type="estado_envio_correo"/>

  <xs:simpleType name="id_o_vacio">
    <xs:union memberTypes="xs:positiveInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="conteo_o_vacio">
    <xs:union memberTypes="xs:nonNegativeInteger">
      <xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <!-- Número (entero, decimal o notación científica que emite str(float) de Python) o vacío (None). -->
  <xs:simpleType name="numero_o_vacio">
    <xs:union memberTypes="xs:decimal xs:double">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value=""/>
          <xs:enumeration value="nan"/>
          <xs:enumeration value="inf"/>
          <xs:enumeration value="-inf"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="estado_oc">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="EMITIDA"/>
      <xs:enumeration value="ENVIADA"/>
      <xs:enumeration value="RECIBIDA_PARCIAL"/>
      <xs:enumeration value="RECIBIDA"/>
      <xs:enumeration value="CANCELADA"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="estado_envio_correo">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="NO_ENVIADO"/>
      <xs:enumeration value="ENVIADO_SMTP"/>
      <xs:enumeration value="REGISTRADO_SIN_SMTP"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
