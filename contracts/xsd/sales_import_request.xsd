<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-commercial POST /api/v1/commercial/sales/import (importación masiva de ventas desde la app de escritorio) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:complexType name="lineaType">
    <xs:all>
      <xs:element name="id_sku" type="xs:positiveInteger"/>
      <xs:element name="cantidad">
        <xs:simpleType><xs:restriction base="xs:decimal"><xs:minExclusive value="0"/></xs:restriction></xs:simpleType>
      </xs:element>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="ticketType">
    <xs:all>
      <xs:element name="folio_externo">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="60"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="canal" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="TIENDA"/>
            <xs:enumeration value="ONLINE"/>
            <xs:enumeration value="MAYOREO"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="lineas">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="linea" type="lineaType" minOccurs="1" maxOccurs="100"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>
  <xs:element name="sales_import_request">
    <xs:complexType>
      <xs:all>
        <xs:element name="id_locacion" type="xs:positiveInteger"/>
        <xs:element name="tickets">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ticket" type="ticketType" minOccurs="1" maxOccurs="500"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
