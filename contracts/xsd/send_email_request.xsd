<?xml version="1.0" encoding="UTF-8"?>
<!-- svc-planning POST /api/v1/planning/purchase-orders/<id_oc>/send-email (la app de escritorio lo valida antes de enviar) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="send_email_request">
    <xs:complexType>
      <xs:all>
        <xs:element name="correo">
          <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="254"/><xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/></xs:restriction></xs:simpleType>
        </xs:element>
        <xs:element name="mensaje" minOccurs="0">
          <xs:simpleType><xs:restriction base="xs:string"><xs:maxLength value="2000"/></xs:restriction></xs:simpleType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
