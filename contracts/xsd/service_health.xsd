<?xml version="1.0" encoding="UTF-8"?>
<!-- GET /health de cualquier microservicio con Accept: application/xml -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="service_health">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="service" type="xs:string"/>
        <xs:element name="status">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="HEALTHY"/>
              <xs:enumeration value="DEGRADED"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="version" type="xs:string"/>
        <xs:element name="process" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="status" type="xs:string"/>
              <xs:element name="pid" type="xs:integer"/>
              <xs:element name="uptime_seconds" type="xs:decimal"/>
              <xs:element name="started_at" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="response_time_ms" type="xs:decimal" minOccurs="0"/>
        <xs:element name="checked_at" type="xs:string" minOccurs="0"/>
        <xs:element name="dependencies">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="postgres" type="xs:boolean" minOccurs="0"/>
              <xs:element name="mongo" type="xs:boolean" minOccurs="0"/>
              <xs:element name="redis" type="xs:boolean" minOccurs="0"/>
              <xs:element name="bucket" type="xs:boolean" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- Último error 5xx registrado por el servicio (solo si existe). -->
        <xs:element name="last_error" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="timestamp" type="xs:string"/>
              <xs:element name="source" type="xs:string"/>
              <xs:element name="endpoint" type="xs:string"/>
              <xs:element name="status" type="xs:string"/>
              <xs:element name="code" type="xs:string"/>
              <xs:element name="message" type="xs:string"/>
              <xs:element name="correlation_id" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
