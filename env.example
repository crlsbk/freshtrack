# =============================================================================
# FreshTrack — variables de entorno
#
# Copia este archivo a .env y ajusta los valores:
#     cp env.example .env
#
# .env NO se sube al repositorio (.gitignore). Ninguna credencial vive en el
# código: la aplicación falla al arrancar si falta SECRET_KEY o DATABASE_URL.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=retail_perecederos
POSTGRES_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia_esta_clave_de_superusuario
POSTGRES_PORT=5432

# Contraseñas de los roles de aplicación creados por sql/00_init_roles.sh.
# app_backend  → la usa la aplicación web (permisos mínimos sobre los esquemas)
# app_auditor  → solo lectura, para el perfil de auditoría
APP_BACKEND_PASSWORD=cambia_esta_clave_de_backend
APP_AUDITOR_PASSWORD=cambia_esta_clave_de_auditor

# --- MongoDB -----------------------------------------------------------------
# Documentos: series de pronóstico, avisos ASN de proveedores y alertas
# operativas (con índice TTL). Lo usan svc-asn, svc-planning y svc-alerts.
MONGO_DB=retail_perecederos
MONGO_USER=freshtrack_mongo
MONGO_PASSWORD=cambia_esta_clave_de_mongo
MONGO_PORT=27017

# --- Redis -------------------------------------------------------------------
# Sesiones (session:{jti}), denylist de JWT revocados (jwt:denylist:{jti}),
# caché de consultas, contadores, rate limiting, carritos temporales, bloqueos
# distribuidos y el stream de eventos. Lo usan los 8 microservicios y la web.
REDIS_PASSWORD=cambia_esta_clave_de_redis
REDIS_PORT=6379

# --- Conexiones --------------------------------------------------------------
# La usa la aplicación Flask (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://app_backend:cambia_esta_clave_de_backend@localhost:5432/retail_perecederos
# La usa el ETL, que necesita desactivar los disparadores durante la carga masiva.
ETL_DATABASE_URL=postgresql://postgres:cambia_esta_clave_de_superusuario@localhost:5432/retail_perecederos

# --- Seguridad ---------------------------------------------------------------
# SECRET_KEY firma la cookie de sesión web; JWT_SECRET_KEY firma los tokens de
# la API. Genera valores propios con:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_de_sesion
JWT_SECRET_KEY=cambia_esta_clave_de_jwt
JWT_HORAS_VIGENCIA=8

# --- Parámetros de negocio (la base de datos manda si define el valor) --------
HORIZONTE_PRONOSTICO_DIAS=7
VENTANA_MEDIA_MOVIL=28
ALPHA_SUAVIZACION=0.30

# --- Servidor ----------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false

# --- Microservicios ------------------------------------------------------------
# Host con el que el navegador abre Swagger o clientes externos alcanzan las APIs
# (en un servidor en GCP: tu dominio o <IP>.nip.io).
SVC_PUBLIC_HOST=localhost
# La web delega login, ventas, mermas, productos, pronóstico y reabastecimiento a
# los microservicios por HTTP. Ponlo en false solo si quieres correr la web sin
# levantar los 8 servicios (modo autónomo, para trabajar en la interfaz).
WEB_USA_MICROSERVICIOS=true

# --- Cloud Object Storage (S3 local o Google Cloud Storage HMAC) -------------
# En local con Docker usa http://127.0.0.1:9000 (interno http://minio:9000).
# En GCP con Google Cloud Storage nativo:
#   OBJECT_STORAGE_ENDPOINT=https://storage.googleapis.com
#   OBJECT_STORAGE_REGION=auto
#   OBJECT_STORAGE_BUCKET=freshtrack-reportes-<proyecto>
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=freshtrack_s3
OBJECT_STORAGE_SECRET_KEY=freshtrack_s3_secret_2026
OBJECT_STORAGE_BUCKET=freshtrack-reportes
OBJECT_STORAGE_REGION=us-east-1

# --- Correo saliente: Órdenes de Compra y Hoja QR del ASN (PDF adjunto) -----
# Con Docker ya hay un servidor SMTP corriendo: el contenedor "mail" (Mailpit).
# Todos los correos se ven en http://localhost:8025 aunque no configures nada.
#
# Para que además LLEGUEN al buzón real, llena estas 4 líneas y reinicia "mail":
#   docker compose up -d mail
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (16 letras, sin espacios).
# Outlook/Office 365: MAIL_RELAY_HOST=smtp.office365.com
# MAIL_RELAY_HOST=smtp.gmail.com
# MAIL_RELAY_USERNAME=tu_correo@gmail.com
# MAIL_RELAY_PASSWORD=tu_contraseña_de_aplicacion
# MAIL_RELAY_ALL=true
#
# Opcionales del relay: MAIL_RELAY_PORT=587, MAIL_RELAY_STARTTLS=true, MAIL_RELAY_AUTH=plain
# Puertos en tu equipo: MAIL_UI_PORT=8025 (bandeja web), MAIL_SMTP_PORT=1025
#
# Avanzado (sin Mailpit): manda directo a otro SMTP definiendo SMTP_HOST/PORT/USER/PASSWORD/TLS/FROM.
# Sin Docker (python run.py) y sin SMTP_HOST, el envío solo se registra en la bitácora.
# SMTP_FROM=FreshTrack <no-reply@freshtrack.mx>

# --- Producción HTTPS / GCP (docker-compose.prod.yml + Caddy) ----------------
# En local déjalos en false. En GCP con Caddy HTTPS pon SESSION_COOKIE_SECURE=true
# y TRUST_PROXY=true, y asigna tu dominio o <IP_EXTERNA>.nip.io en PUBLIC_DOMAIN.
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_DOMAIN=localhost
ACME_EMAIL=admin@freshtrack.mx
# Bucket GCS opcional para almacenar respaldos nocturnos (deploy/backup_db.sh)
# GCS_BACKUP_BUCKET=freshtrack-backups-<proyecto>

# --- Monitoreo privado (/ops/status) -----------------------------------------
APP_VERSION=1.0.0
MONITOR_USER=ops_monitor
MONITOR_PASSWORD=cambia_esta_clave_de_monitoreo
