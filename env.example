# =============================================================================
# FreshTrack — variables de entorno
#
# Copia este archivo a .env y ajusta los valores:
#     cp env.example .env
#
# .env NO se sube al repositorio (.gitignore). Ninguna credencial vive en el
# código: la aplicación falla al arrancar si falta SECRET_KEY o DATABASE_URL.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=retail_perecederos
POSTGRES_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia_esta_clave_de_superusuario
POSTGRES_PORT=5432

# Contraseñas de los roles de aplicación creados por sql/00_init_roles.sh.
# app_backend  → la usa la aplicación web (permisos mínimos sobre los esquemas)
# app_auditor  → solo lectura, para el perfil de auditoría
APP_BACKEND_PASSWORD=cambia_esta_clave_de_backend
APP_AUDITOR_PASSWORD=cambia_esta_clave_de_auditor

# --- MongoDB -----------------------------------------------------------------
# Pronósticos, avisos ASN y alertas operativas. Desplegado, pero todavía NO es
# fuente de datos de ningún flujo: el sistema opera contra PostgreSQL.
MONGO_DB=retail_perecederos
MONGO_USER=freshtrack_mongo
MONGO_PASSWORD=cambia_esta_clave_de_mongo
MONGO_PORT=27017

# --- Redis -------------------------------------------------------------------
# Sesiones, denylist de JWT revocados, caché de catálogos y bloqueos distribuidos.
# Desplegado, pero todavía NO es fuente de datos de ningún flujo.
REDIS_PASSWORD=cambia_esta_clave_de_redis
REDIS_PORT=6379

# --- Conexiones --------------------------------------------------------------
# La usa la aplicación Flask (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://app_backend:cambia_esta_clave_de_backend@localhost:5432/retail_perecederos
# La usa el ETL, que necesita desactivar los disparadores durante la carga masiva.
ETL_DATABASE_URL=postgresql://postgres:cambia_esta_clave_de_superusuario@localhost:5432/retail_perecederos

# --- Seguridad ---------------------------------------------------------------
# SECRET_KEY firma la cookie de sesión web; JWT_SECRET_KEY firma los tokens de
# la API. Genera valores propios con:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_de_sesion
JWT_SECRET_KEY=cambia_esta_clave_de_jwt
JWT_HORAS_VIGENCIA=8

# --- Parámetros de negocio (la base de datos manda si define el valor) --------
HORIZONTE_PRONOSTICO_DIAS=7
VENTANA_MEDIA_MOVIL=28
ALPHA_SUAVIZACION=0.30

# --- Servidor ----------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false
